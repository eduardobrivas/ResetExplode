<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes do motor do teste de RAM (MemTester.cs) com defeitos simulados: roda em qualquer sistema e sem pacotes.
    Rodar: dotnet run -c Release (pasta Tests/MemTests)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\MemTester.cs" Link="Engine\MemTester.cs" />
  </ItemGroup>

</Project>
